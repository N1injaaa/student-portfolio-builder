# Скопируйте этот файл в .env.local (без .example на конце) и заполните значения.
# .env.local никогда не попадает в git — секреты в нём в безопасности.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Только для сервера, НИКОГДА не добавляйте префикс NEXT_PUBLIC_ ---
# Supabase → Project Settings → API → "service_role" (секретный!) ключ.
# Используется только в вебхуке (app/api/webhooks/lemonsqueezy/route.ts),
# чтобы выставлять is_pro в обход обычных прав пользователя.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Lemon Squeezy → ваш магазин → Settings → Webhooks → Signing secret
# (задаёте сами при создании вебхука, любая строка 6-40 символов).
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret
